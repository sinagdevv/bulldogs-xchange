# Runtime
NODE_ENV=development
ENABLE_DEV_AUTH=false
DEV_AUTH_EMAIL=
DEV_AUTH_ROLE=Customer
FRONTEND_ORIGIN=
DATA_PROVIDER=mock

# Supabase PostgreSQL
SUPABASE_DATABASE_URL=
SUPABASE_CA_CERT_PATH=certs/supabase-prod-ca-2021.crt
POSTGRES_SSL=true
POSTGRES_POOL_MAX=3

# Auth0 Authentication
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Power Automate Notifications
PA_NOTIFY_EVENT_URL=
BX_AUTOMATION_SECRET=

# Outbox Security
OUTBOX_DISPATCH_SECRET=
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_SECONDS=120

# Optional Integrations: legacy SQL Server provider
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=BulldogsXchange
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# Optional Integrations: legacy SharePoint provider
SHAREPOINT_SITE_URL=https://nuph.sharepoint.com/sites/BulldogsExchange
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_CATEGORIES=
SHAREPOINT_LIST_PRODUCTS=
SHAREPOINT_LIST_PRODUCT_VARIANTS=
SHAREPOINT_LIST_INVENTORY=
SHAREPOINT_LIST_USERS=
SHAREPOINT_LIST_RESERVATIONS=
SHAREPOINT_LIST_RESERVATION_ITEMS=
SHAREPOINT_LIST_QUEUES=
SHAREPOINT_LIST_TRANSACTIONS=
SHAREPOINT_LIST_TRANSACTION_ITEMS=
SHAREPOINT_LIST_INVENTORY_MOVEMENTS=
SHAREPOINT_LIST_NOTIFICATIONS=
SHAREPOINT_LIST_AUDIT_LOGS=
SHAREPOINT_LIST_SYSTEM_SETTINGS=
# Optional Integrations: legacy Power Automate CRUD provider
PA_TEST_URL=
PA_CATALOG_URL=
PA_CUSTOMER_URL=
PA_STAFF_URL=
PA_ADMIN_URL=
PA_CREATE_RESERVATION_URL=
PA_CANCEL_RESERVATION_URL=
PA_MARK_READY_URL=
PA_QUEUE_ACTION_URL=
PA_ADJUST_STOCK_URL=
PA_RESTOCK_URL=
PA_PROCESS_TRANSACTION_URL=
PA_SAVE_PRODUCT_URL=
PA_SET_PRODUCT_ACTIVE_URL=
PA_SAVE_CATEGORY_URL=
PA_SET_CATEGORY_ACTIVE_URL=
PA_SAVE_VARIANT_URL=
PA_SET_VARIANT_ACTIVE_URL=
PA_CHANGE_USER_ROLE_URL=
