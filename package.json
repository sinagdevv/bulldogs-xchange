{
  "name": "bulldogs-xchange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:api": "npm run build --silent && node --env-file=.env.local scripts/dev-api.mjs",
    "dev:demo:api": "npm run build --silent && node --env-file=.env.local-demo scripts/dev-api.mjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "demo:preview": "npm --prefix frontend run build && node --env-file=.env.local-demo scripts/demo-preview.mjs",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "build:static-preview": "node scripts/build-static-preview.mjs",
    "audit:static-preview": "node scripts/audit-static-preview.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "node scripts/db.mjs check",
    "db:schema": "node scripts/db.mjs schema",
    "db:seed:reference": "node scripts/db.mjs reference",
    "db:seed:demo": "node scripts/db.mjs demo",
    "db:workflows": "node scripts/db.mjs workflows",
    "db:verify": "node scripts/db.mjs verify",
    "db:integrity": "node --env-file=.env.local scripts/integrity-check.mjs",
    "db:smoke": "node scripts/db.mjs smoke",
    "db:outbox": "node scripts/db.mjs outbox",
    "db:superseded": "node scripts/db.mjs superseded",
    "outbox:dispatch": "npm run build --silent && node --env-file=.env.local dist/src/cli/outbox-dispatch.js",
    "outbox:dispatch-one": "npm run build --silent && node --env-file=.env.local dist/src/cli/outbox-dispatch-one.js",
    "test:sql:workflows": "node --env-file=.env.local scripts/workflow-smoke.mjs",
    "test:sql:concurrency": "node --env-file=.env.local scripts/concurrency-smoke.mjs",
    "db:pg:schema": "node --env-file=.env.local scripts/postgres-db.mjs schema",
    "db:pg:seed": "node --env-file=.env.local scripts/postgres-db.mjs seed",
    "db:pg:integrity": "node --env-file=.env.local scripts/postgres-db.mjs integrity",
    "test:pg": "node --env-file=.env.local scripts/postgres-db.mjs smoke",
    "test:pg:rollback": "npm run build --silent && node --env-file=.env.local scripts/postgres-rollback-validation.mjs",
    "test:financial:staging": "node --env-file=.env.financial-staging scripts/financial-staging-validation.mjs",
    "test:financial:e2e": "npm run build --silent && node --env-file=.env.financial-staging scripts/financial-postgres-e2e.mjs",
    "test:financial:concurrency": "npm run build --silent && node --env-file=.env.financial-staging scripts/financial-concurrency-validation.mjs",
    "test:pg:outbox": "npm run build --silent && node --env-file=.env.local scripts/outbox-postgres-validation.mjs",
    "test:live:reservation-notification": "npm run build --silent && node --env-file=.env.local scripts/live-reservation-notification.mjs",
    "auth:bootstrap-admin": "npm run build --silent && node --env-file=.env.local dist/src/cli/bootstrap-admin.js",
    "auth:provision-accounts": "npm run build --silent && node --env-file=.env.local dist/src/cli/provision-accounts.js"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "mssql": "^12.7.4",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "xlsx-chart": "^0.4.3",
    "xlsx-populate": "^1.21.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "supabase": "^2.120.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
